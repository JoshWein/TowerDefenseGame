{
  "name": "ikblife",
  "version": "1.0.0",
  "description": "International Klein Blue Life",
  "dependencies": {
    "easystarjs": "^0.3.0",
    "firebase": "^13.2.0",
    "font-awesome": "^4.7.0",
    "normalize.css": "^5.0.0",
    "object-hash": "1.1.5",
    "phaser": "~2.6.2",
    "random-seed": "^0.3.0"
  },
  "scripts": {
    "build:lib": "node -e \"require('fs').mkdirSync('public/built',{recursive:true})\" && cp node_modules/phaser/build/phaser.min.js public/built/lib.js",
    "build:fonts": "cp -rT node_modules/font-awesome/fonts public/built/font-awesome",
    "build:js": "esbuild src/main.ts --bundle --minify --sourcemap --target=es2020 --alias:object-hash=./node_modules/object-hash/dist/object_hash.js --outfile=public/built/app.js",
    "build:css": "sass --no-source-map --quiet --quiet-deps --silence-deprecation=import,global-builtin,color-functions,slash-div styles/main.scss public/built/app.css",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:lib && npm run build:fonts && npm run build:js && npm run build:css",
    "watch:js": "npm run build:js -- --watch",
    "watch:css": "npm run build:css -- --watch",
    "serve": "esbuild --servedir=public --serve=8080",
    "devserver": "concurrently --kill-others \"npm:watch:js\" \"npm:watch:css\" \"npm:serve\"",
    "start": "npm run build && npm run devserver",
    "deploy": "npm run build && firebase deploy"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/object-hash": "0.5.28",
    "@types/random-seed": "^0.3.0",
    "bourbon": "^4.2.7",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "firebase-tools": "^15.0.0",
    "sass": "^1.108.1",
    "typescript": "~5.9.3"
  }
}
